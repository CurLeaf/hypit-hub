{
  "format": "hypit.runtime-local@1",
  "dataRoot": ".hypit/runtimes/local",
  "credentials": {
    "env": { "use": "@hypit/credential-store-env" },
    "os": { "use": "@hypit/credential-store-os" }
  },
  "endpoints": {
    "whisperx.local": {
      "use": "@hypit/provider-whisperx-local",
      "config": {
        "expectedModel": "small",
        "expectedDevice": "cpu",
        "expectedCompute": "int8",
        "expectedBatchSize": 8,
        "requestTimeoutMs": 1200000
      }
    },
    "media.local": {
      "use": "@hypit/provider-media-local",
      "config": { "defaultConcurrency": 2 }
    },
    "hyperframes.local": {
      "use": "@hypit/provider-hyperframes-local",
      "config": { "workers": 2, "defaultConcurrency": 1 }
    },
    "gateway.default": {
      "use": "@hypit/provider-openai-compatible",
      "config": {
        "baseUrl": "https://ai-api.qzsyzn.com/v1",
        "apiKey": { "store": "env", "key": "OPENAI_API_KEY" },
        "defaultConcurrency": 1,
        "videoAdapter": "openai-videos",
        "models": {
          "@hypit/gpt-image@1#gpt-image-2": "gpt-image-2"
        },
        "routes": {
          "image": "/images/generations",
          "imageEdits": "/images/edits",
          "speech": "/audio/speech",
          "videoSubmit": "/videos",
          "videoStatus": "/videos/{id}"
        }
      }
    },
    "gateway.minimax": {
      "use": "@hypit/provider-openai-compatible",
      "config": {
        "baseUrl": "https://metaso.cn/api/minimax",
        "apiKey": { "store": "env", "key": "H3_VIDEO_API_KEY" },
        "defaultConcurrency": 2,
        "videoAdapter": "openai-videos",
        "models": {
          "@hypit/minimax-h3@1#minimax-h3": "MiniMax-H3"
        },
        "routes": {
          "image": "/images/generations",
          "imageEdits": "/images/edits",
          "speech": "/audio/speech",
          "videoSubmit": "/videos",
          "videoStatus": "/videos/{id}"
        }
      }
    },
    "hypihub.default": {
      "use": "@hypit/provider-hypihub",
      "pool": "hypihub.default",
      "config": {
        "baseUrl": "https://hypit.ai",
        "apiKey": { "store": "os", "key": "hypihub.oauth" },
        "defaultConcurrency": 2,
        "pollIntervalMs": 10000
      }
    }
  },
  "bindings": {
    "@hypit/whisperx@1#whisperx-alignment": "whisperx.local",
    "@hypit/gpt-image@1#gpt-image-2": "gateway.default",
    "@hypit/minimax-h3@1#minimax-h3": "gateway.minimax",
    "@hypit/fishaudio-speech@1#voice-design-1": "hypihub.default"
  }
}
