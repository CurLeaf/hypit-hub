# Cursor Agent 导演审查（Analysis 自动改写口播）
# 在 Cursor Dashboard → Integrations 创建 API Key：https://cursor.com/dashboard/integrations
CURSOR_API_KEY=cursor_your-key-here
# 设为 manual 关闭自动 Agent，仅手动启动或手改 director/ 文件
# HYPIT_DIRECTOR_AGENT=manual
# HYPIT_DIRECTOR_AGENT_AUTO=1
# HYPIT_DIRECTOR_AGENT_MODEL=composer-2.5

# OpenAI-compatible gateway — baseUrl is { store: "env", key: "OPENAI_BASE_URL" }
# in hypit.runtime.json (gateway.default). 生图模型见 models 映射（本网关可用 gpt-image-2）
OPENAI_BASE_URL=https://ai-api.qzsyzn.com/v1
OPENAI_API_KEY=sk-your-key-here

# 若直连 Google Gemini OpenAI 兼容端点，可改用 GOOGLE_API_KEY，并把 baseUrl 设为：
# https://generativelanguage.googleapis.com/v1beta/openai
# GOOGLE_API_KEY=your-gemini-api-key

# 爆款解读 / Brief / Treatment 使用的对话模型（与 gateway.default.chatModel 一致）
HYPIT_CHAT_MODEL=deepseek-v4-flash

# 上传参考图复刻时：改写口播后由 TTS 合成配音（OpenAI 兼容 /audio/speech）
# OpenAI 官方网关可用 tts-1 + alloy；本示例中转网关用 CosyVoice2
HYPIT_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
HYPIT_TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:alex

# MiniMax H3 V2 video gateway — baseUrl is { store: "env", key: "H3_VIDEO_BASE_URL" }
# in hypit.runtime.json (gateway.minimax). Model: MiniMax-H3
H3_VIDEO_BASE_URL=https://metaso.cn/api/minimax
H3_VIDEO_API_KEY=mk-your-minimax-key-here

# 本地 Python 解释器：WhisperX / OpenCV / yt-dlp 的 uv 环境都由它构建（vfox 管理）
# 写解释器绝对路径，不要只写版本号
# HYPIT_PYTHON=/path/to/python3

# H3 参考图/音色公有 OSS（gateway.minimax.referenceUpload=s3 时必填）
# 模型拉取 {S3_CDN}/hypit/references/…，不再走 MiniMax POST /files
S3_PROVIDER=aliyun
S3_REGION=cn-hangzhou
S3_ACCESS_KEY_ID=your-access-key
S3_BUCKET_NAME=your-bucket
S3_SECRET_ACCESS_KEY=your-secret-key
S3_ENDPOINT=https://your-bucket.oss-cn-hangzhou.aliyuncs.com
S3_CDN=https://cdn.example.com

# Analysis UI「使用默认视频」：仓库根目录 pnpm upload:origin 会把 origin.mp4
# 传到 hypit/default/origin.mp4
# HYPIT_DEFAULT_VIDEO_URL=https://cdn.example.com/hypit/default/origin.mp4

# 可选：Fish Voice Design（官方口播音色，替代 TTS 音色样本）
# 复制 hypit.runtime.hypihub.example.json 为 hypit.runtime.json 后执行：
#   hypit auth login hypihub.default --runtime hypit.runtime.json
# Analysis 检测到 @hypit/fishaudio-speech@1 绑定后会自动使用 fish:VoiceDesign
