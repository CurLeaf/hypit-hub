<?svml using="@hypit/markup@1"?>
<svml>
  <import from="@hypit/script@1"/>
  <import as="text" from="@hypit/text@1"/>
  <import as="asset" from="@hypit/media@1"/>
  <import as="gpt" from="@hypit/gpt-image@1"/>
  <import as="pipeline" from="@hypit/media-pipeline@1"/>
  <import as="whisperx" from="@hypit/whisperx@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="sound" from="@hypit/sound@1"/>
  <import as="media-track" from="@hypit/media-track@1"/>
  <import as="caption-fine" from="@hypit/caption-fine@1"/>
  <import as="fonts" from="@hypit/fonts-open@1"/>
  <import as="spatial" from="@hypit/spatial@1"/>
  <import as="program" from="@hypit/program-space@1"/>
  <import as="ranking" from="@hypit/ranking@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="render" from="@hypit/render-hyperframes@1"/>
  <import as="recipes" source="../recipes.svs"/>

  <script id="story">
    <main>
      <HOST>今天我们来给这些内容排个级。 ||  @tier-1 群星云重磅发布星图220动动口视频商品图张口就来 @/tier-1 ||  @scene-2 0动动口视频商品图张口就来不满意 @/scene-2
    </main>
  </script>

  <text:Value id="presenter-prompt">Vertical 9:16 classroom or studio host, confident presenter holding microphone, cinematic UGC lighting, Chinese short video ranking show, no readable text.</text:Value>
  <gpt:Image id="presenter" prompt={presenter-prompt} aspect-ratio="9:16" resolution="1K"/>
  <asset:Audio id="speech-audio" src="./../assets/reference-audio.wav"/>
  <asset:Audio id="ranking-appear-sfx" src="./../assets/ranking-appear.wav"/>
  <asset:Audio id="ranking-move-sfx" src="./../assets/ranking-move.wav"/>

  <text:Value id="tier-1-icon-prompt">Square icon portrait for a tier-list ranking board, bold studio lighting, 群 星 云 重 磅 发 布 星 图 2 2 0 动 动 口 视 频 商 品 图 张 口 就 来 不 满 意 直 接 喊 让 它 一 直 改 改 到 满 意 为 , no text, no logos, editorial product style.</text:Value>
  <gpt:Image id="tier-1-icon" prompt={tier-1-icon-prompt} aspect-ratio="1:1" resolution="1K"/>

  <text:Value id="scene-2-prompt">Vertical 9:16 short-form social video frame, cinematic lighting, clean composition. Chinese product promo scene 2. Theme: 0动动口视频商品图张口就来不满意 群 星 云 重 磅 发 布 星 图 2 2 0 动 动 口 视 No readable text in image.</text:Value>
  <gpt:Image id="scene-2" prompt={scene-2-prompt} aspect-ratio="4:3" resolution="1K"/>

  <text:Value id="scene-3-prompt">Vertical 9:16 short-form social video frame, cinematic lighting, clean composition. Chinese product promo scene 3. Theme: 意直接喊让它一直改改到满意为止 群 星 云 重 磅 发 布 星 图 2 2 0 动 动 口 视 No readable text in image.</text:Value>
  <gpt:Image id="scene-3" prompt={scene-3-prompt} aspect-ratio="4:3" resolution="1K"/>

  <text:Value id="scene-4-prompt">Vertical 9:16 short-form social video frame, cinematic lighting, clean composition. Chinese product promo scene 4. Theme: 止星图220想说就说创意随你 群 星 云 重 磅 发 布 星 图 2 2 0 动 动 口 视 No readable text in image.</text:Value>
  <gpt:Image id="scene-4" prompt={scene-4-prompt} aspect-ratio="4:3" resolution="1K"/>

  <program:Clock id="clock" frame-rate="30"/>
  <spatial:Canvas id="vertical" width="768" height="1344"/>
  <spatial:Frame id="speech-frame" within={vertical} left="0%" top="0%" right="100%" bottom="52%"/>
  <spatial:Frame id="tier-frame" within={vertical} left="0%" top="55%" right="100%" bottom="100%"/>
  <spatial:Frame id="broll-frame" within={vertical} left="10%" top="18%" right="90%" bottom="48%"/>
  <spatial:Extent id="hero-extent" width="768" height="739"/>
  <spatial:Extent id="broll-extent" width="1024" height="768"/>

  <pipeline:Normalize id="speech-media" source={speech-audio}
    video="none" audio="default" span-authority="audio" clock={clock}/>
  <pipeline:Normalize id="ranking-appear-media" source={ranking-appear-sfx}
    video="none" audio="default" span-authority="audio" clock={clock}/>
  <pipeline:Normalize id="ranking-move-media" source={ranking-move-sfx}
    video="none" audio="default" span-authority="audio" clock={clock}/>
  <whisperx:SemanticTake id="speech-semantic" narrative={story}
    segment={story.segment.main} media={speech-media.media} language="zh"/>

  <time:Timeline id="speech" clock={clock}>
    <time:Take source={speech-semantic.take}/>
  </time:Timeline>

  <sound:Style id="speech-sound-style"/>
  <sound:Track id="speech-sound" timeline={speech.timeline}>
    <sound:Use style={speech-sound-style}/>
  </sound:Track>

  <media-track:Track id="hero" timeline={speech.timeline} canvas={vertical}>
    <media-track:Item id="presenter-card" image={presenter.image}
      extent={hero-extent} during="program"
      frame={speech-frame} appearance={recipes.media.hero}/>

    <media-track:Item id="scene-2-card" image={scene-2.image}
      extent={broll-extent} during={story.selection.scene-2}
      frame={broll-frame} appearance={recipes.media.broll}
      motion={recipes.motion.broll}/>

    <media-track:Item id="scene-3-card" image={scene-3.image}
      extent={broll-extent} during={story.selection.scene-3}
      frame={broll-frame} appearance={recipes.media.broll}
      motion={recipes.motion.broll}/>

    <media-track:Item id="scene-4-card" image={scene-4.image}
      extent={broll-extent} during={story.selection.scene-4}
      frame={broll-frame} appearance={recipes.media.broll}
      motion={recipes.motion.broll}/>
  </media-track:Track>

  <fonts:Stack id="display-font" family="noto-sans-sc" weight="700" style="normal"/>
  <fonts:Stack id="tier-font" family="noto-sans-sc" weight="400" style="normal"/>
  <ranking:TierBoardStyle id="tier-style" recipe={recipes.ranking.football} font={tier-font}/>
  <ranking:TierBoard id="tiers" timeline={speech.timeline} canvas={vertical} frame={tier-frame}
    during="program" style={tier-style}
    appear-sound={ranking-appear-media.media}
    move-sound={ranking-move-media.media}>

    <ranking:TierItem id="tier-1-row" tier="s" entry="drop" icon={tier-1-icon.image} during={story.selection.tier-1}/>
  </ranking:TierBoard>

  <caption-fine:Style id="caption-style" recipe={recipes.caption.primary} font={display-font}/>
  <caption-fine:Track id="captions" document={story.caption} timeline={speech.timeline}>
    <caption-fine:Use style={caption-style}/>
  </caption-fine:Track>

  <film:Film id="main" canvas={vertical} timeline={speech.timeline} appearance={recipes.film.vertical}>
    <film:Track source={hero.visual}/>
    <film:Track source={speech-sound.audio}/>
    <film:Track source={tiers.visual}/>
    <film:Track source={tiers.audio}/>
    <film:Track source={captions.track}/>
  </film:Film>
  <render:Video id="final" composition={main.composition} timeline={speech.timeline}/>
</svml>
