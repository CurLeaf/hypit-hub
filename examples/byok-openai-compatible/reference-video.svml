<?svml using="@hypit/markup@1"?>
<svml>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="spatial" from="@hypit/spatial@1"/>
  <import as="text" from="@hypit/text@1"/>
  <import as="asset" from="@hypit/media@1"/>
  <import as="h3" from="@hypit/minimax-h3@1"/>
  <import as="pipeline" from="@hypit/media-pipeline@1"/>
  <import as="media-track" from="@hypit/media-track@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="render" from="@hypit/render-hyperframes@1"/>
  <import as="style" source="./minimal.svs"/>

  <asset:Image id="presenter-reference" src="./assets/product-reference.jpg"/>
  <asset:Audio id="voice-reference" src="./assets/voice-reference.wav"/>

  <text:Value id="speaker-prompt">Create a realistic vertical phone-shot talking-head video. The reference image shows the visible speaker and scene. The reference audio supplies voice timbre. Deliver the script with clear lip-sync. Dialogue: 群星云重磅发布星图220，动动口就能做视频，商品图张口就来。 PERFORMANCE: engaged Chinese product presenter with natural social-video energy.</text:Value>

  <h3:ReferenceVideo id="speaker-take" prompt={speaker-prompt} duration="6"
    resolution="768P" aspect-ratio="9:16">
    <h3:Reference image={presenter-reference.image}/>
    <h3:Reference audio={voice-reference}/>
  </h3:ReferenceVideo>

  <time:Clock id="clock" frame-rate="30"/>
  <time:Timeline id="program" clock={clock} end="6s"/>
  <spatial:Canvas id="canvas" width="1080" height="1920"/>
  <spatial:Frame id="full-frame" within={canvas} left="0%" top="0%" right="100%" bottom="100%"/>
  <pipeline:Normalize id="speaker-media" source={speaker-take.video}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>

  <media-track:Track id="visual" timeline={program.timeline} canvas={canvas}>
    <media-track:Item id="hero" media={speaker-media.media}
      during="program" frame={full-frame} appearance={style.media.hero}/>
  </media-track:Track>

  <film:Film id="main" canvas={canvas} timeline={program.timeline} appearance={style.film.main}>
    <film:Track source={visual.visual}/>
  </film:Film>
  <render:Video id="final" composition={main.composition} timeline={program.timeline}/>
</svml>
