# Copy to `.env` in this directory. Analysis / Runtime 从仓库根目录加载这些变量。
# 密钥不要提交；`cp .env.example .env` 后只填自己的值。

# OpenAI-compatible gateway (images and general models)
# hypit.runtime.json: gateway.default.baseUrl / apiKey
OPENAI_BASE_URL=https://ai-api.qzsyzn.com/v1
OPENAI_API_KEY=sk-your-key-here

# 对话模型（改写口播 / Brief / Treatment）；须与网关 models 列表中的 ID 完全一致（区分大小写）
HYPIT_CHAT_MODEL=deepseek-v4-flash

# TTS 配音（网关无 tts-1 时用 CosyVoice2）
HYPIT_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
HYPIT_TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:alex

# MiniMax H3 video gateway
# hypit.runtime.json: gateway.minimax.baseUrl / apiKey（官方 V2 /v2/video_generation）
H3_VIDEO_BASE_URL=https://metaso.cn/api/minimax
H3_VIDEO_API_KEY=mk-your-minimax-key-here

# 本地 Python 解释器：WhisperX / OpenCV / yt-dlp 的 uv 环境都由它构建（vfox 管理）
# 写解释器绝对路径，不要只写版本号
HYPIT_PYTHON=/path/to/python3

# H3 参考图/音色公有 OSS（与 erp-admin-demo-1 相同；gateway.minimax.referenceUpload=s3）
S3_PROVIDER=aliyun
S3_REGION=cn-hangzhou
S3_ACCESS_KEY_ID=
S3_BUCKET_NAME=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://your-bucket.oss-cn-hangzhou.aliyuncs.com
S3_CDN=https://cdn.example.com

# Analysis UI「使用默认视频」：仓库根目录 pnpm upload:origin 会把 origin.mp4
# 传到 hypit/default/origin.mp4
HYPIT_DEFAULT_VIDEO_URL=https://cdn.example.com/hypit/default/origin.mp4
