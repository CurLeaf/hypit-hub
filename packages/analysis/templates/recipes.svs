<?svml using="@hypit/svs@1"?>
<sheet version="1">
  speaker.host {
    composition-stability: soft-locked;
    camera-motion: none;
    edit-rhythm: pause-trim-jump-cuts;
    performance: high-energy-ugc;
    gesture: natural;
  }

  film.vertical { background: #0b0c10; }

  media.hero {
    stack-order: 5;
    fit: cover;
    frame-x: 0.5;
    frame-y: 0.5;
    content-x: 0.5;
    content-y: 0.5;
  }

  media.broll {
    stack-order: 20;
    fit: cover;
    shadows: 0 16 32 -8 #000000CC;
  }

  motion.broll {
    enter: pop;
    enter-frames: 6;
    enter-easing: ease-out;
    exit: fade;
    exit-frames: 4;
    exit-easing: ease-in;
  }

  caption.primary {
    stack-order: 70;
    x: 0.5;
    y: 0.78;
    width: 0.9;
    height: 0.12;
    anchor-x: center;
    anchor-y: center;
    align: center;
    block-align: center;
    inline-size: hug;
    wrap: word;
    max-lines: 2;
    max-words-per-line: 6;
    line-height: 1.25;
    size: 42;
    letter-spacing: 0;
    fill: #FFFFFF;
    stroke-color: #090A0F;
    stroke-width: 2;
    shadow-color: #000000;
    shadow-opacity: 0.7;
    shadow-x: 0;
    shadow-y: 2;
    shadow-blur: 6;
    background: #00000000;
    border-color: #00000000;
    border-width: 0;
    padding: 0 0;
    radius: 0;
    karaoke: off;
    active-box: off;
    handoff: cut;
    lead-frames: 2;
    tail-frames: 2;
    cue-enter: fade;
    cue-enter-frames: 2;
    cue-exit: fade;
    cue-exit-frames: 2;
  }
</sheet>
