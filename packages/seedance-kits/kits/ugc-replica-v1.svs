<?svml using="@hypit/text/svs@1"?>

<sheet version="1" id="ugc-replica-v1">
  text-template.ugc-replica-v1 {
    separator: paragraph;
    default-composition-stability: soft-locked;
    default-camera-motion: none;
    default-edit-rhythm: continuous-take;
    default-performance: natural-explainer;
    default-gesture: natural;
  }

  text-template.ugc-replica-v1.block.base {
    kind: fixed;
    order: 10;
    text: "Create a realistic vertical phone-shot social promo video. @image1 is the primary scene and product reference. Preserve product identity, setting, lighting, lens feel, and broad composition from the references. @audio1 is the voice-timbre reference for the voiceover.";
  }

  text-template.ugc-replica-v1.block.script-contract {
    kind: fixed;
    order: 20;
    text: "Deliver the supplied script as a natural voiceover with conversational pacing and clear emphasis. A visible on-camera person is optional — product demos, hands-only shots, detail inserts, and environment cuts are all valid when they match the reference style. Do not rewrite, summarize, add, remove, or reorder words.";
  }

  text-template.ugc-replica-v1.block.composition-stability {
    kind: axis;
    order: 30;
    parameter: composition-stability;
  }

  text-template.ugc-replica-v1.choice.composition-stability.flexible-ugc {
    text: "COMPOSITION: preserve the reference setup while allowing natural short-form framing variation and cut-friendly visual beats.";
  }

  text-template.ugc-replica-v1.choice.composition-stability.soft-locked {
    text: "COMPOSITION: keep the subject region and reference composition stable, allowing natural posture or camera micro-adjustments.";
  }

  text-template.ugc-replica-v1.choice.composition-stability.strict-locked {
    text: "COMPOSITION: preserve subject placement, perspective, background relationship, and framing envelope throughout the shot.";
  }

  text-template.ugc-replica-v1.block.camera-motion {
    kind: axis;
    order: 40;
    parameter: camera-motion;
  }

  text-template.ugc-replica-v1.choice.camera-motion.none {
    text: "CAMERA: hold a steady fixed framing.";
  }

  text-template.ugc-replica-v1.choice.camera-motion.subtle-punch-in-return {
    text: "CAMERA: use one subtle push-in on the most important phrase, then return smoothly to the original framing.";
  }

  text-template.ugc-replica-v1.block.edit-rhythm {
    kind: axis;
    order: 50;
    parameter: edit-rhythm;
  }

  text-template.ugc-replica-v1.choice.edit-rhythm.continuous-take {
    text: "EDIT RHYTHM: one continuous creator clip with natural breath timing.";
  }

  text-template.ugc-replica-v1.choice.edit-rhythm.pause-trim-jump-cuts {
    text: "EDIT RHYTHM: polished pause-trim jump cuts at phrase boundaries while keeping the framing coherent.";
  }

  text-template.ugc-replica-v1.block.performance {
    kind: axis;
    order: 60;
    parameter: performance;
  }

  text-template.ugc-replica-v1.choice.performance.natural-explainer {
    text: "PERFORMANCE: engaged, friendly short-form delivery with responsive intonation and clear emphasis as the thought develops.";
  }

  text-template.ugc-replica-v1.choice.performance.high-energy-ugc {
    text: "PERFORMANCE: vivid, energetic short-form delivery with nimble phrasing and emphatic key ideas.";
  }

  text-template.ugc-replica-v1.choice.performance.calm-authority {
    text: "PERFORMANCE: composed, thoughtful conviction with measured phrasing and purposeful vocal emphasis.";
  }

  text-template.ugc-replica-v1.block.gesture {
    kind: axis;
    order: 70;
    parameter: gesture;
  }

  text-template.ugc-replica-v1.choice.gesture.restrained {
    text: "GESTURE: restrained movement; let product detail, framing, and voice carry the meaning.";
  }

  text-template.ugc-replica-v1.choice.gesture.natural {
    text: "GESTURE: natural creator gestures such as open palms, small pointing beats, or posture shifts where the script calls for them.";
  }

  text-template.ugc-replica-v1.block.hygiene {
    kind: fixed;
    order: 80;
    text: "Keep lighting, skin, product texture, and motion photoreal and stable. Add no subtitles, captions, labels, logos, UI text, floating words, or other readable on-screen text.";
  }

  text-template.ugc-replica-v1.block.dialogue {
    kind: slot;
    order: 90;
    slot: dialogue;
    optional: false;
    label: "SCRIPT TO DELIVER:";
  }

  text-template.ugc-replica-v1.block.action {
    kind: slot;
    order: 100;
    slot: action;
    optional: true;
    label: "VISUAL AND PERFORMANCE DIRECTION:";
  }
</sheet>
