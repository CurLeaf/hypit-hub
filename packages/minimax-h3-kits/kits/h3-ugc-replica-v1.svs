<?svml using="@hypit/text/svs@1"?>

<sheet version="1" id="h3-ugc-replica-v1">
  text-template.h3-ugc-replica-v1 {
    separator: paragraph;
    default-composition-stability: soft-locked;
    default-camera-motion: none;
    default-edit-rhythm: continuous-take;
    default-performance: natural-explainer;
    default-gesture: natural;
  }

  text-template.h3-ugc-replica-v1.block.base {
    kind: fixed;
    order: 10;
    text: "MiniMax H3 reference-to-video (r2va): generate one new clip from the supplied reference_image inputs and reference audio 1. Reference images, in upload order, establish scene, subject, product identity, wardrobe, lighting, and lens feel; when multiple reference images are present, preserve continuity from earlier frames and keep the product-facing reference recognizable. Reference audio 1 is a short timbre sample (2–15 seconds) — use it only for vocal color, register, and accent. Generate fresh speech and synchronized picture for the requested clip duration; do not replay, transcribe, or lip-sync to the reference audio file itself.";
  }

  text-template.h3-ugc-replica-v1.block.script-contract {
    kind: fixed;
    order: 20;
    text: "Narrate or speak the supplied script as newly generated audio in the referenced timbre. Voice timbre follows reference audio 1. A visible on-camera person is optional — product demos, hands-only shots, detail inserts, and environment shots are valid when they match the reference style. Do not rewrite, summarize, add, remove, or reorder words.";
  }

  text-template.h3-ugc-replica-v1.block.composition-stability {
    kind: axis;
    order: 30;
    parameter: composition-stability;
  }

  text-template.h3-ugc-replica-v1.choice.composition-stability.flexible-ugc {
    text: "COMPOSITION: preserve the reference setup while allowing natural short-form framing variation within one continuous clip.";
  }

  text-template.h3-ugc-replica-v1.choice.composition-stability.soft-locked {
    text: "COMPOSITION: keep the subject region and reference composition stable, allowing natural posture or camera micro-adjustments.";
  }

  text-template.h3-ugc-replica-v1.choice.composition-stability.strict-locked {
    text: "COMPOSITION: preserve subject placement, perspective, background relationship, and framing envelope throughout the clip.";
  }

  text-template.h3-ugc-replica-v1.block.camera-motion {
    kind: axis;
    order: 40;
    parameter: camera-motion;
  }

  text-template.h3-ugc-replica-v1.choice.camera-motion.none {
    text: "CAMERA: hold a steady fixed framing for the full generated duration.";
  }

  text-template.h3-ugc-replica-v1.choice.camera-motion.subtle-punch-in-return {
    text: "CAMERA: use one subtle push-in on the most important phrase, then return smoothly to the original framing within the same clip.";
  }

  text-template.h3-ugc-replica-v1.block.edit-rhythm {
    kind: axis;
    order: 50;
    parameter: edit-rhythm;
  }

  text-template.h3-ugc-replica-v1.choice.edit-rhythm.continuous-take {
    text: "PACING: one continuous in-camera performance with natural breath timing across the full clip.";
  }

  text-template.h3-ugc-replica-v1.choice.edit-rhythm.pause-trim-jump-cuts {
    text: "PACING: phrase-boundary pauses and emphasis shifts inside one continuous clip; do not simulate post-production jump cuts.";
  }

  text-template.h3-ugc-replica-v1.block.performance {
    kind: axis;
    order: 60;
    parameter: performance;
  }

  text-template.h3-ugc-replica-v1.choice.performance.natural-explainer {
    text: "PERFORMANCE: engaged, friendly short-form delivery with responsive intonation and clear emphasis as the thought develops.";
  }

  text-template.h3-ugc-replica-v1.choice.performance.high-energy-ugc {
    text: "PERFORMANCE: vivid, energetic short-form delivery with nimble phrasing and emphatic key ideas.";
  }

  text-template.h3-ugc-replica-v1.choice.performance.calm-authority {
    text: "PERFORMANCE: composed, thoughtful conviction with measured phrasing and purposeful vocal emphasis.";
  }

  text-template.h3-ugc-replica-v1.block.gesture {
    kind: axis;
    order: 70;
    parameter: gesture;
  }

  text-template.h3-ugc-replica-v1.choice.gesture.restrained {
    text: "GESTURE: restrained movement; let product detail, framing, and voice carry the meaning.";
  }

  text-template.h3-ugc-replica-v1.choice.gesture.natural {
    text: "GESTURE: natural creator gestures such as open palms, small pointing beats, or posture shifts where the script calls for them.";
  }

  text-template.h3-ugc-replica-v1.block.hygiene {
    kind: fixed;
    order: 80;
    text: "Keep lighting, skin, product texture, and motion photoreal and stable within the generated clip. Add no subtitles, captions, labels, logos, UI text, floating words, or other readable on-screen text.";
  }

  text-template.h3-ugc-replica-v1.block.dialogue {
    kind: slot;
    order: 90;
    slot: dialogue;
    optional: false;
    label: "Spoken script:";
  }

  text-template.h3-ugc-replica-v1.block.action {
    kind: slot;
    order: 100;
    slot: action;
    optional: true;
    label: "Visual direction:";
  }
</sheet>
