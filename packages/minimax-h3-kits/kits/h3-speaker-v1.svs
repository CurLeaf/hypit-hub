<?svml using="@hypit/text/svs@1"?>

<sheet version="1" id="h3-speaker-v1">
  text-template.h3-speaker-v1 {
    separator: paragraph;
    default-composition-stability: soft-locked;
    default-camera-motion: none;
    default-edit-rhythm: continuous-take;
    default-performance: natural-explainer;
    default-gesture: natural;
  }

  text-template.h3-speaker-v1.block.base {
    kind: fixed;
    order: 10;
    text: "MiniMax H3 reference-to-video (r2va): generate one new talking-head clip from reference image 1 and reference audio 1. Reference image 1 defines the visible speaker, outfit, setting, lighting, lens feel, and broad composition. Reference audio 1 is a short timbre sample (2–15 seconds) — use it only for vocal color, register, and accent. Generate fresh speech and synchronized picture for the requested clip duration; do not replay or lip-sync to the reference audio file itself.";
  }

  text-template.h3-speaker-v1.block.script-contract {
    kind: fixed;
    order: 20;
    text: "Deliver the supplied script exactly in order with clear lip-sync from the visible person. Voice timbre follows reference audio 1. Do not rewrite, summarize, add, remove, or reorder words.";
  }

  text-template.h3-speaker-v1.block.composition-stability {
    kind: axis;
    order: 30;
    parameter: composition-stability;
  }

  text-template.h3-speaker-v1.choice.composition-stability.flexible-ugc {
    text: "COMPOSITION: preserve the reference person and setup while allowing normal lively creator-video framing variation within one continuous clip.";
  }

  text-template.h3-speaker-v1.choice.composition-stability.soft-locked {
    text: "COMPOSITION: keep the speaker in the same general region and preserve the reference composition, allowing natural posture changes and tiny crop or scale breathing.";
  }

  text-template.h3-speaker-v1.choice.composition-stability.strict-locked {
    text: "COMPOSITION: preserve subject placement, perspective, left-right orientation, background relationship, and framing envelope throughout the clip.";
  }

  text-template.h3-speaker-v1.block.camera-motion {
    kind: axis;
    order: 40;
    parameter: camera-motion;
  }

  text-template.h3-speaker-v1.choice.camera-motion.none {
    text: "CAMERA: hold a steady fixed framing for the full generated duration.";
  }

  text-template.h3-speaker-v1.choice.camera-motion.subtle-punch-in-return {
    text: "CAMERA: use one subtle push-in on the most important phrase, then return smoothly to the original framing within the same clip.";
  }

  text-template.h3-speaker-v1.block.edit-rhythm {
    kind: axis;
    order: 50;
    parameter: edit-rhythm;
  }

  text-template.h3-speaker-v1.choice.edit-rhythm.continuous-take {
    text: "PACING: one continuous in-camera explanation with natural breath timing across the full clip.";
  }

  text-template.h3-speaker-v1.choice.edit-rhythm.pause-trim-jump-cuts {
    text: "PACING: phrase-boundary pauses and emphasis shifts inside one continuous clip; do not simulate post-production jump cuts.";
  }

  text-template.h3-speaker-v1.block.performance {
    kind: axis;
    order: 60;
    parameter: performance;
  }

  text-template.h3-speaker-v1.choice.performance.natural-explainer {
    text: "PERFORMANCE: engaged, friendly conversation with responsive intonation and clear emphasis as the thought develops. Let gaze, expression, and gesture convey the speaker's attitude to what they are saying.";
  }

  text-template.h3-speaker-v1.choice.performance.high-energy-ugc {
    text: "PERFORMANCE: vivid, energetic short-form delivery with nimble phrasing, animated intonation, and emphatic key ideas. Let the voice and visible reactions develop together as the speaker makes their point.";
  }

  text-template.h3-speaker-v1.choice.performance.calm-authority {
    text: "PERFORMANCE: composed, thoughtful conviction with measured phrasing and purposeful vocal emphasis. Let focused attention and small, deliberate reactions express how the speaker weighs the idea and reaches a judgment.";
  }

  text-template.h3-speaker-v1.choice.performance.reactive-playful {
    text: "PERFORMANCE: playful, responsive delivery with teasing inflection, lively timing, and an audible smile where the thought amuses the speaker. Let curiosity, skepticism, or delight come through in the voice and matching visible reactions as the passage calls for them.";
  }

  text-template.h3-speaker-v1.block.gesture {
    kind: axis;
    order: 70;
    parameter: gesture;
  }

  text-template.h3-speaker-v1.choice.gesture.restrained {
    text: "GESTURE: restrained body language; let face, eyes, and voice carry the meaning.";
  }

  text-template.h3-speaker-v1.choice.gesture.compact {
    text: "GESTURE: compact explanatory hand movement close to the torso and inside the frame.";
  }

  text-template.h3-speaker-v1.choice.gesture.natural {
    text: "GESTURE: natural creator gestures such as open palms, small pointing beats, nods, and posture shifts where the script calls for them.";
  }

  text-template.h3-speaker-v1.choice.gesture.expressive {
    text: "GESTURE: richer hand, shoulder, and posture changes that support the spoken idea while remaining physically coherent.";
  }

  text-template.h3-speaker-v1.block.hygiene {
    kind: fixed;
    order: 80;
    text: "Keep face, hands, skin texture, lighting, and motion photoreal and stable within the generated clip. Add no subtitles, captions, labels, logos, UI text, floating words, or other readable on-screen text.";
  }

  text-template.h3-speaker-v1.block.dialogue {
    kind: slot;
    order: 90;
    slot: dialogue;
    optional: false;
    label: "Character speaks:";
  }

  text-template.h3-speaker-v1.block.action {
    kind: slot;
    order: 100;
    slot: action;
    optional: true;
    label: "Performance direction:";
  }
</sheet>
